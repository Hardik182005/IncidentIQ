# ── AI Providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-proj-...

# Get from https://aistudio.google.com/app/apikey (linked to your GCP account)
# OR leave blank to use Application Default Credentials (ADC) on Cloud Run
GOOGLE_API_KEY=

# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...

# ── Slack ─────────────────────────────────────────────────────────────────────
# Incoming Webhook URL from Slack App settings
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=incidentiq-01
GCP_LOCATION=us-central1

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Monitoring Integrations ───────────────────────────────────────────────────

# Datadog: https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# Grafana: Configuration > API keys (or service-account token)
GRAFANA_URL=
GRAFANA_API_KEY=
# Loki base URL (often same host as Grafana but :3100). Leave blank to use GRAFANA_URL.
GRAFANA_LOKI_URL=

# New Relic: User key from https://one.newrelic.com/admin-portal/api-keys
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_REGION=US

# ── Agent ─────────────────────────────────────────────────────────────────────
# Set to "true" to auto-start the monitoring agent on backend boot
AGENT_AUTOSTART=false
